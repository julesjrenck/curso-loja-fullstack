# Modelo público. Copie para .env.testing e preencha os valores somente na cópia local.
APP_NAME="Loja Fullstack - Testes"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002

# SQL Server na rede Docker; banco e conta exclusivos dos testes.
DB_URL=
DB_CONNECTION=sqlsrv
DB_HOST=sqlserver
DB_PORT=1433
DB_DATABASE=loja_test
DB_USERNAME=loja_testes
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# Configurações dos testes, já apresentadas em phpunit.xml.
BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
