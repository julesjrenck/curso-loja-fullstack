{
  "openapi": "3.2.1",
  "info": {
    "title": "API de catálogo da loja",
    "version": "0.1.0",
    "description": "Descrição em construção. As operações do catálogo serão acrescentadas gradualmente."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8002",
      "description": "Ambiente local de desenvolvimento"
    }
  ],
  "paths": {
    "/api/v1/produtos": {
      "get": {
        "summary": "Listar produtos ativos",
        "operationId": "listarProdutos",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Número da página. Quando omitido, usa 1. Quando informado, após a normalização do Laravel, deve ser um inteiro decimal positivo sem sinal ou zeros iniciais, entre 1 e 1000000. Valor vazio ou inválido recebe 422. Páginas após a última retornam 200 com lista vazia.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "description": "Trecho literal do nome do produto. Omitido não aplica filtro por nome. Quando informado, após remover espaços externos, deve ser texto não vazio de até 100 caracteres; espaços internos são preservados e '0' é válido. Vazio, somente espaços, arrays ou texto acima do limite recebem 422. A busca ignora maiúsculas/minúsculas e distingue acentos; %, _ e [ são literais. O filtro é aplicado aos ativos antes de contar e paginar, e o nome normalizado é preservado nos links.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de produtos ativos correspondentes à busca, incluindo paginação. A lista pode estar vazia.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "maxItems": 10,
                      "items": {
                        "$ref": "#/components/schemas/Produto"
                      }
                    },
                    "links": {
                      "type": "object",
                      "description": "Links de navegação; URLs preservam o nome normalizado quando informado.",
                      "required": [
                        "first",
                        "last",
                        "prev",
                        "next"
                      ],
                      "properties": {
                        "first": {
                          "type": "string",
                          "description": "URL da primeira página."
                        },
                        "last": {
                          "type": "string",
                          "description": "URL da última página."
                        },
                        "prev": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "URL da página anterior, ou null quando não houver."
                        },
                        "next": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "URL da página seguinte, ou null quando não houver."
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "current_page",
                        "per_page",
                        "total",
                        "last_page",
                        "from",
                        "to",
                        "path",
                        "links"
                      ],
                      "properties": {
                        "current_page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000,
                          "description": "Página solicitada."
                        },
                        "per_page": {
                          "type": "integer",
                          "const": 10,
                          "description": "Capacidade fixa por página, mesmo quando data contém menos itens."
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Total de produtos ativos correspondentes ao filtro em todas as páginas."
                        },
                        "last_page": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Última página calculada; pelo menos 1, mesmo quando total é zero."
                        },
                        "from": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1,
                          "description": "Posição inicial dos itens na lista completa, ou null quando a página está vazia."
                        },
                        "to": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1,
                          "description": "Posição final dos itens na lista completa, ou null quando a página está vazia."
                        },
                        "path": {
                          "type": "string",
                          "description": "URL base da listagem, sem parâmetros da query."
                        },
                        "links": {
                          "type": "array",
                          "description": "Opções de navegação geradas pelo paginador; URLs não nulas preservam o nome normalizado quando informado.",
                          "items": {
                            "type": "object",
                            "required": [
                              "url",
                              "label",
                              "page",
                              "active"
                            ],
                            "properties": {
                              "url": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "URL de navegação, ou null quando a opção não tem destino."
                              },
                              "label": {
                                "type": "string",
                                "description": "Rótulo de exibição; pode variar com a tradução."
                              },
                              "page": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "minimum": 1,
                                "description": "Página de destino, ou null quando não houver."
                              },
                              "active": {
                                "type": "boolean",
                                "description": "Indica se a opção numérica representa a página atual."
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "nome": "Camiseta",
                      "preco_em_centavos": 4990
                    }
                  ],
                  "links": {
                    "first": "http://127.0.0.1:8002/api/v1/produtos?page=1",
                    "last": "http://127.0.0.1:8002/api/v1/produtos?page=1",
                    "prev": null,
                    "next": null
                  },
                  "meta": {
                    "current_page": 1,
                    "per_page": 10,
                    "total": 1,
                    "last_page": 1,
                    "from": 1,
                    "to": 1,
                    "path": "http://127.0.0.1:8002/api/v1/produtos",
                    "links": [
                      {
                        "url": null,
                        "label": "Anterior",
                        "page": null,
                        "active": false
                      },
                      {
                        "url": "http://127.0.0.1:8002/api/v1/produtos?page=1",
                        "label": "1",
                        "page": 1,
                        "active": true
                      },
                      {
                        "url": null,
                        "label": "Próximo",
                        "page": null,
                        "active": false
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Parâmetros de consulta inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "errors"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Resumo do erro de validação; o texto pode variar com a tradução."
                    },
                    "errors": {
                      "type": "object",
                      "minProperties": 1,
                      "description": "Mensagens agrupadas pelo nome do campo inválido; nesta operação, page e/ou nome.",
                      "additionalProperties": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Os dados enviados são inválidos.",
                  "errors": {
                    "nome": [
                      "Informe um nome válido."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/produtos/{id}": {
      "get": {
        "summary": "Consultar produto ativo pelo ID",
        "operationId": "consultarProduto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador do produto, em decimal positivo sem sinal ou zeros iniciais. Deve caber na faixa de inteiros do PHP do backend (PHP_INT_MAX); formato inválido ou valor fora da faixa recebe 404.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto ativo encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Produto"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 1,
                    "nome": "Camiseta",
                    "preco_em_centavos": 4990
                  }
                }
              }
            }
          },
          "404": {
            "description": "Produto não encontrado, inativo ou identificador inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Descrição do erro. Produto inexistente, inativo ou ID fora da faixa de inteiros recebem 'Produto não encontrado.'. Nos erros de roteamento, o texto pode variar."
                    }
                  }
                },
                "example": {
                  "message": "Produto não encontrado."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Produto": {
        "type": "object",
        "description": "Representação pública de um produto do catálogo.",
        "required": [
          "id",
          "nome",
          "preco_em_centavos"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "preco_em_centavos": {
            "type": "integer",
            "description": "Preço em centavos; 4990 representa R$ 49,90."
          }
        }
      }
    }
  }
}
