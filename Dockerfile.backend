FROM php:8.4.26-cli-bookworm

COPY --from=composer/composer:2.10.3-bin /composer /usr/local/bin/composer

RUN curl -fsSL https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
        -o /tmp/packages-microsoft-prod.deb \
    && echo '8434dcb8c346dc95fbd63dbece056c343704590b58b6a5c323d39acf52bf0b48  /tmp/packages-microsoft-prod.deb' | sha256sum -c - \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb

RUN apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
        unzip=6.0-28+deb12u1 \
        libgssapi-krb5-2=1.20.1-2+deb12u5 \
        msodbcsql18=18.7.1.1-1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git=1:2.39.5-0+deb12u3 \
        libtool=2.4.7-7~deb12u1 \
        unixodbc-dev=2.3.11-2+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/php/pie/releases/download/1.5.2/pie.phar \
        -o /usr/local/bin/pie \
    && echo 'fe70c59738cf56ec00a818cf9cb9593da171aac86f5f1f859995b8839dfd2cc7  /usr/local/bin/pie' | sha256sum -c - \
    && chmod +x /usr/local/bin/pie \
    && pie install --no-interaction --no-cache --make-parallel-jobs=2 microsoft/sqlsrv:5.13.3 \
    && pie install --no-interaction --no-cache --make-parallel-jobs=2 microsoft/pdo_sqlsrv:5.13.3

CMD ["php", "artisan", "--version"]
